# --- Runtime ---
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173

# --- Database (docker compose postgres on host port 54329) ---
DATABASE_APP_URL=postgres://agentdesk_app:agentdesk_app@localhost:54329/agentdesk
DATABASE_OWNER_URL=postgres://agentdesk_owner:agentdesk_owner@localhost:54329/agentdesk
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
AGENTDESK_OWNER_PASSWORD=agentdesk_owner
AGENTDESK_APP_PASSWORD=agentdesk_app
TEMPORAL_PASSWORD=temporal

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=agentdesk

# --- Auth ---
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
AUTH_DEV_LOGIN=true

# --- GitHub App (optional; set all or none) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Kubernetes / runner ---
KUBE_MODE=fake
KUBECONFIG=
RUNS_NAMESPACE=agentdesk-runs
APP_NAMESPACE=agentdesk
RUNNER_IMAGE=agentdesk-runner:dev

# --- Fake provider (local dev) ---
FAKE_STATE_DIR=.agentdesk/fake
FAKE_WEBHOOK_SECRET=dev
ENABLE_FAKE_PROVIDER=true

# --- Misc ---
POLL_MAX_BACKOFF_SECONDS=3600
OTEL_EXPORTER_OTLP_ENDPOINT=
BOT_NAME=agentdesk[bot]
BOT_EMAIL=agentdesk-bot@users.noreply.local
