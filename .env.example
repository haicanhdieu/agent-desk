# --- Runtime ---
NODE_ENV=development
PORT=3000
# HOST=127.0.0.1   # bind address; default 0.0.0.0 (the runner stack sets 127.0.0.1)
PUBLIC_ORIGIN=http://localhost:5173

# --- Database (docker compose postgres on host port 54329) ---
DATABASE_APP_URL=postgres://agentdesk_app:agentdesk_app@localhost:54329/agentdesk
DATABASE_OWNER_URL=postgres://agentdesk_owner:agentdesk_owner@localhost:54329/agentdesk
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
AGENTDESK_OWNER_PASSWORD=agentdesk_owner
AGENTDESK_APP_PASSWORD=agentdesk_app
TEMPORAL_PASSWORD=temporal

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=agentdesk

# --- Auth ---
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
AUTH_DEV_LOGIN=true

# --- GitHub App (optional; set all or none) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Kubernetes / runner ---
KUBE_MODE=fake
KUBECONFIG=
RUNS_NAMESPACE=agentdesk-runs
APP_NAMESPACE=agentdesk
RUNNER_IMAGE=agentdesk-runner:dev

# --- Fake provider (local dev) ---
# Relative paths resolve against the repo root (the dir with pnpm-workspace.yaml), so api and worker share it.
FAKE_STATE_DIR=.agentdesk/fake
FAKE_WEBHOOK_SECRET=dev
ENABLE_FAKE_PROVIDER=true
# The local stack and e2e never call the model provider: the model list is the built-in names only.
AGENT_MODELS_SOURCE=builtin

# --- Workspace setup and plugins ---
RUN_PLUGIN_MARKETPLACES={"claude-plugins-official":"anthropics/claude-plugins-official","anthropic-plugin-directory":"builtin"}
RUN_SETUP_TIMEOUT_SECONDS=600
PROJECT_ENV_MAX_ENTRIES=500

# --- Pause and resume (per-run volumes) ---
RUN_VOLUME_STORAGE_CLASS=
RUN_KEPT_DONE_SESSIONS_PER_PROJECT=10

# --- Misc ---
SSE_HEARTBEAT_MS=15000
TERMINAL_PING_MS=30000
TERMINAL_REAUTH_MS=60000
SSE_DRAIN_TIMEOUT_MS=30000
SSE_SAFETY_TICK_MS=30000
POLL_MAX_BACKOFF_SECONDS=3600
OTEL_EXPORTER_OTLP_ENDPOINT=
BOT_NAME=
BOT_EMAIL=agentdesk-bot@users.noreply.local

# --- Test seams (leave unset for normal use) ---
# Test override: seconds an idle run waits before its pod is stopped and the run pauses. Set to anything but 1800,
# it wins over every agent's saved "End idle runs after"; left at 1800 (or unset), each agent's setting applies.
# See docs/runbooks/local-dev.md.
# RUN_IDLE_END_SECONDS=1800
# RUN_ENDING_DEADLINE_SECONDS=90
# Terminal attach leases: the api sends live socket ids every TERMINAL_LEASE_INTERVAL_MS; the workflow drops an id
# unheard for RUN_LEASE_TTL_SECONDS (keep the interval well under the lease time).
# TERMINAL_LEASE_INTERVAL_MS=120000
# RUN_LEASE_TTL_SECONDS=300

# --- Web dev server ---
# Extra hostnames Vite accepts besides localhost, comma separated (e.g. a hostname served by a reverse proxy).
# Empty keeps Vite's default. Restart the web process after changing it.
WEB_ALLOWED_HOSTS=
