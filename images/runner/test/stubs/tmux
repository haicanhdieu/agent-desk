#!/usr/bin/env node
// Test stub: logs argv. STUB_TMUX_MODE: `dead` (default) the agent pane is dead at once with status STUB_PANE_STATUS or
// 0; `incident` the session is gone (has-session exits 1) and display-message prints nothing; `alive` the session
// exists and the pane never dies.
import { appendFileSync } from 'node:fs';

const argv = process.argv.slice(2);
appendFileSync(
  process.env.STUB_LOG,
  `${JSON.stringify({ cmd: 'tmux', argv, setupScript: process.env.SETUP_SCRIPT ?? null })}\n`,
);
const mode = process.env.STUB_TMUX_MODE ?? 'dead';
// Session-level commands take a SESSION target: `=agent` is valid, anything else is not.
if (argv.includes('has-session') || argv.includes('attach')) {
  if (argv[argv.indexOf('-t') + 1] !== '=agent') {
    console.error(`can't find session: ${argv[argv.indexOf('-t') + 1]}`);
    process.exit(1);
  }
  if (mode === 'incident') process.exit(1);
  process.exit(0);
}
// Real tmux: `-t =agent` (no colon) is not a valid PANE target. capture-pane fails, display-message prints an empty line.
const target = argv[argv.indexOf('-t') + 1];
const badPaneTarget = argv.includes('-t') && target === '=agent';
if (argv.includes('capture-pane') && badPaneTarget) {
  console.error("can't find pane: =agent");
  process.exit(1);
}
if (argv.includes('display-message') && badPaneTarget) {
  console.log('');
  process.exit(0);
}
if (argv.includes('display-message') && mode !== 'incident') {
  const format = argv[argv.length - 1];
  if (format.includes('pane_dead_status')) console.log(process.env.STUB_PANE_STATUS ?? '0');
  else console.log(mode === 'alive' ? '0' : '1');
}
