#!/usr/bin/env node
// Test stub: logs argv, then runs the wrapped command (argv[1..]). Enforces a numeric limit like coreutils timeout:
// the command's process group is killed after argv[0] seconds and the exit code is 124.
import { spawn } from 'node:child_process';
import { appendFileSync } from 'node:fs';

const argv = process.argv.slice(2);
appendFileSync(process.env.STUB_LOG, `${JSON.stringify({ cmd: 'timeout', argv })}\n`);
const [limit, cmd, ...args] = argv;
const seconds = Number(limit);
const child = spawn(cmd, args, { stdio: 'inherit', detached: true });
let timedOut = false;
const timer =
  seconds > 0
    ? setTimeout(() => {
        timedOut = true;
        process.kill(-child.pid, 'SIGKILL');
      }, seconds * 1000)
    : undefined;
child.on('close', (code) => {
  clearTimeout(timer);
  process.exit(timedOut ? 124 : (code ?? 1));
});
