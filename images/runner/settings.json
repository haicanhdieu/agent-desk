{
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "echo 'agentdesk: turn started' > /proc/1/fd/1" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "echo 'agentdesk: turn finished' > /proc/1/fd/1" }]
      }
    ]
  }
}
