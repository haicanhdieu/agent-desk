#!/bin/bash
# `gh` wrapper for run pods: when $AGENTDESK_TOKEN_FILE is set, exports GH_TOKEN from it on every call (so a rotated
# token is used at once), then runs the real `gh` found on PATH after this directory. Without a token file it changes
# nothing. No `set -x`: the token is a secret.
set -euo pipefail

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clean_path=""
IFS=':' read -r -a parts <<< "${PATH:-}"
for p in "${parts[@]}"; do
  [ "$p" = "$self_dir" ] && continue
  clean_path="${clean_path:+$clean_path:}$p"
done

real="$(PATH="$clean_path" command -v gh || true)"
if [ -z "$real" ]; then
  echo 'gh: not found' >&2
  exit 127
fi

if [ -n "${AGENTDESK_TOKEN_FILE:-}" ]; then
  if [ ! -r "$AGENTDESK_TOKEN_FILE" ]; then
    echo 'agentdesk: workspace token file is missing or unreadable' >&2
    exit 1
  fi
  GH_TOKEN="$(tr -d '\r\n' < "$AGENTDESK_TOKEN_FILE")"
  export GH_TOKEN
fi
exec "$real" "$@"
