#!/bin/bash
# Attach to the agent's tmux session as one named client: `agentdesk-attach <uuid>`. The pid file
# ${AGENTDESK_RUN_DIR:-/run/agentdesk}/attach/<uuid>.pid lets `agentdesk-detach <uuid>` end exactly this client, so a
# dropped terminal cannot leave a client behind. The id is untrusted: it is used only after the strict uuid check.
# A detach that ran first left a `-` tombstone in the pid file; then this exits 3 without attaching (no orphan client).
# Exit codes: 2 bad id, 3 no agent session or already detached.
set -euo pipefail
LC_ALL=C
export LC_ALL

id="${1:-}"
if [[ ! "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
  echo "agentdesk-attach: invalid terminal id" >&2
  exit 2
fi

if ! tmux has-session -t '=agent' 2>/dev/null; then
  echo "agentdesk-attach: no agent session" >&2
  exit 3
fi

dir="${AGENTDESK_RUN_DIR:-/run/agentdesk}/attach"
mkdir -p -- "$dir"
# noclobber: never overwrite or follow anything already at the path (a detach tombstone means detach got here first).
if ! (set -C; printf '%s\n' "$$" > "$dir/$id.pid") 2>/dev/null; then
  rm -f -- "$dir/$id.pid"
  echo "agentdesk-attach: already detached" >&2
  exit 3
fi
# exec keeps this pid: the file names the tmux client process itself. -u: tmux takes a client for UTF-8 only when
# LC_ALL/LC_CTYPE/LANG say so (the C locale pinned above does not), and a client that is not UTF-8 gets every non-ASCII
# glyph as underscores.
exec tmux -u attach -t '=agent'
