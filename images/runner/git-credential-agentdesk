#!/bin/bash
# git credential helper for run pods. Answers `get` with the workspace token read from $AGENTDESK_TOKEN_FILE on every
# call, so a token the control plane rotates in the mounted Secret is picked up without restarting anything.
# `store` and `erase` are ignored: the file is the only source of truth. It answers only for https requests whose host
# is exactly $AGENTDESK_GIT_HOST (the code host of the project's repo, set by the control plane); any other host or
# protocol (a foreign fetch or submodule URL) and an unset $AGENTDESK_GIT_HOST get no answer, so the token never goes
# to another host. Never prints the token anywhere but stdout of `get`, and no `set -x`.
set -euo pipefail

case "${1:-}" in
  get) ;;
  *) exit 0 ;;
esac

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

allowed_host="$(lower "${AGENTDESK_GIT_HOST:-}")"
req_protocol=""
req_host=""
while IFS='=' read -r key value || [ -n "$key" ]; do
  value="${value%$'\r'}"
  case "$key" in
    protocol) req_protocol="$value" ;;
    host) req_host="$value" ;;
  esac
done
if [ -z "$allowed_host" ] || [ "$req_protocol" != "https" ] || [ "$(lower "$req_host")" != "$allowed_host" ]; then
  exit 0
fi

file="${AGENTDESK_TOKEN_FILE:-}"
if [ -z "$file" ] || [ ! -r "$file" ]; then
  echo 'agentdesk: workspace token file is missing or unreadable' >&2
  exit 1
fi
token="$(tr -d '\r\n' < "$file")"
if [ -z "$token" ]; then
  echo 'agentdesk: workspace token file is empty' >&2
  exit 1
fi
printf 'username=%s\npassword=%s\n' "${AGENTDESK_GIT_USERNAME:-x-access-token}" "$token"
