#!/bin/bash
# git credential helper for run pods. Answers `get` with the workspace token read from $AGENTDESK_TOKEN_FILE on every
# call, so a token the control plane rotates in the mounted Secret is picked up without restarting anything.
# `store` and `erase` are ignored: the file is the only source of truth. Never prints the token anywhere but stdout
# of `get`, and no `set -x`.
set -euo pipefail

case "${1:-}" in
  get) ;;
  *) exit 0 ;;
esac

file="${AGENTDESK_TOKEN_FILE:-}"
if [ -z "$file" ] || [ ! -r "$file" ]; then
  echo 'agentdesk: workspace token file is missing or unreadable' >&2
  exit 1
fi
token="$(tr -d '\r\n' < "$file")"
if [ -z "$token" ]; then
  echo 'agentdesk: workspace token file is empty' >&2
  exit 1
fi
printf 'username=%s\npassword=%s\n' "${AGENTDESK_GIT_USERNAME:-x-access-token}" "$token"
