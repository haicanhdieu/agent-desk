{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "PUBLIC_ORIGIN",
        "DATABASE_*",
        "AGENTDESK_*",
        "TEMPORAL_*",
        "BETTER_AUTH_*",
        "AUTH_*",
        "GITHUB_*",
        "KUBE*",
        "RUNS_NAMESPACE",
        "APP_NAMESPACE",
        "RUNNER_IMAGE",
        "RUN_POD_*",
        "FAKE_*",
        "ENABLE_FAKE_PROVIDER",
        "SSE_*",
        "TERMINAL_*",
        "POLL_*",
        "BOT_*",
        "OTEL_*"
      ]
    },
    "test": {
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "TESTCONTAINERS_RYUK_DISABLED",
        "TEST_PG_*",
        "TEMPORAL_CLI_PATH",
        "TEMPORAL_TEST_SERVER_PATH"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test:unit": {
      "passThroughEnv": ["TEST_PG_*", "TEMPORAL_CLI_PATH", "TEMPORAL_TEST_SERVER_PATH"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "passThroughEnv": ["TEST_PG_*", "TEMPORAL_CLI_PATH", "TEMPORAL_TEST_SERVER_PATH"]
    },
    "test:unit:coverage": {
      "outputs": ["coverage/**"],
      "passThroughEnv": ["TEST_PG_*", "TEMPORAL_CLI_PATH", "TEMPORAL_TEST_SERVER_PATH"]
    },
    "test:integration:coverage": {
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "TESTCONTAINERS_RYUK_DISABLED",
        "TEST_PG_*",
        "TEMPORAL_CLI_PATH",
        "TEMPORAL_TEST_SERVER_PATH"
      ]
    },
    "test:integration": {
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "TESTCONTAINERS_RYUK_DISABLED",
        "TEST_PG_*",
        "TEMPORAL_CLI_PATH",
        "TEMPORAL_TEST_SERVER_PATH"
      ]
    }
  }
}
