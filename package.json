{
  "name": "agent-desk",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "bash scripts/dev.sh up",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "lint": "turbo run lint && eslint scripts eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @agentdesk/api migrate",
    "dev:down": "bash scripts/dev.sh down",
    "stop": "bash scripts/dev.sh down",
    "test:e2e:local": "tsx scripts/e2e-local.ts",
    "test:scripts": "vitest run --root scripts"
  },
  "devDependencies": {
    "@agentdesk/contracts": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@temporalio/client": "1.25.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eventsource-parser": "^4.1.3",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
