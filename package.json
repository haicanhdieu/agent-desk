{
  "name": "agent-desk",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev --filter=@agentdesk/api --filter=@agentdesk/worker --filter=@agentdesk/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @agentdesk/api migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
