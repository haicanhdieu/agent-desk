{
  "name": "@agentdesk/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agentdesk/contracts": "workspace:*",
    "@agentdesk/core": "workspace:*",
    "@agentdesk/db": "workspace:*",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/interceptors-opentelemetry-v2": "1.25.0",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eventsource-parser": "^4.1.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
